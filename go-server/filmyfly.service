[Unit]
Description=FilmySoar Go Fiber Application
After=network-online.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=filmysoar
Group=filmysoar
WorkingDirectory=/opt/filmysoar/go-server
ExecStart=/opt/filmysoar/go-server/filmysoar-server
Restart=always
RestartSec=5
StandardOutput=append:/var/log/filmysoar/app.log
StandardError=append:/var/log/filmysoar/error.log

# Environment variables
Environment="PORT=3000"
EnvironmentFile=/opt/filmysoar/go-server/.env

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/filmysoar /opt/filmysoar/go-server/logs

[Install]
WantedBy=multi-user.target
