---
import {
    siteConfig,
    siteName,
    siteThemeColor,
    copyrightText,
} from "../../config/site";

const apiBase = (
    import.meta.env.PUBLIC_API_BASE_URL || "http://127.0.0.1:3000"
).replace(/\/$/, "");

const emptyMovie = {
    title: "Movie unavailable",
    description: "",
    thumbnail: "",
    genre: "",
    languages: "",
    duration: "",
    releaseYear: "",
    cast: "",
    sizes: "",
    downloadUrl: "",
    screenshot: "",
    keywords: "",
};

let movie = emptyMovie;
let related = [];

try {
    const response = await fetch(
        `${apiBase}/api/movies/${encodeURIComponent(Astro.params.slug || "")}`,
        { method: "GET", signal: AbortSignal.timeout(3000) },
    );
    if (!response.ok) throw new Error("movie api");
    const result = await response.json();
    movie = result.data?.movie ?? emptyMovie;
    related = result.data?.relatedMovies ?? [];
} catch {}

const cleanTitle = (value = "") =>
    value
        .replace(/\s*\([^)]*\)/g, "")
        .replace(
            /\s+(Dual Audio|Hindi|English|Movie|Web Series|HD|ESub|BluRay|HDRip).*$/i,
            "",
        )
        .trim();

const cleanGenre = (value = "") =>
    value
        .replace(/\s*\[.*?\]/g, "")
        .replace(/ Movies?$/i, "")
        .trim();

const label = (value = "") => value || "Not available";
const movieTitle = cleanTitle(movie.title) || movie.title;
const keywords = (movie.keywords || "")
    .split(",")
    .map((keyword) => keyword.trim())
    .filter(Boolean);
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta
            name="viewport"
            content="width=device-width,initial-scale=1,viewport-fit=cover"
        />
        <meta name="description" content={movie.description || movie.title} />
        <meta name="theme-color" content={siteThemeColor} />
        <title>{movie.title} - {siteName}</title>
    </head>
    <body>
        <div class="noise"></div>
        <header class="shell nav">
            <a class="brand" href="/" aria-label={`${siteName} home`}>
                <span class="mark">{siteConfig.branding.logoMark}<span></span></span>
                <span>{siteConfig.branding.logoText}</span>
            </a>
            <nav>
                <a href="/#discover">Discover</a>
                <a href="/#trending">Trending</a>
                <a class="nav-pill" href="/#latest">Explore archive <b></b></a>
            </nav>
        </header>

        <main>
            <section class="shell search-band" id="search">
                <form class="search" action="/search" method="get">
                    <span></span>
                    <input
                        id="movie-search"
                        name="q"
                        type="search"
                        placeholder="Search a title, genre, feeling..."
                        aria-label="Search movies"
                    />
                    <button type="submit">Search</button>
                </form>
            </section>

            <section class="shell movie-hero">
                <a class="back-link" href="/">Back to discovery</a>
                <div class="poster-card">
                    {
                        movie.thumbnail ? (
                            <img
                                src={movie.thumbnail}
                                alt={`${movie.title} poster`}
                                fetchpriority="high"
                            />
                        ) : (
                            <span>{siteConfig.branding.logoText}</span>
                        )
                    }
                    <b>{movie.releaseYear || "HD"}</b>
                </div>
                <div class="movie-copy">
                    <p class="kicker">Now watching</p>
                    <h1>{movieTitle}</h1>
                    <p class="full-title">{movie.title}</p>
                    {
                        keywords.length ? (
                            <div class="tags" aria-label="Movie keywords">
                                {keywords.map((keyword) => (
                                    <span>{keyword}</span>
                                ))}
                            </div>
                        ) : null
                    }
                    <div class="meta-line">
                        <span>{label(movie.languages)}</span>
                        <span>{label(movie.duration)}</span>
                        <span>{cleanGenre(movie.genre) || "Movie"}</span>
                    </div>
                    <div class="hero-actions">
                        <a class="primary" href={movie.downloadUrl || "#"}>
                            Get download link <span></span>
                        </a>
                        <a class="quiet" href="#details">View details</a>
                    </div>
                </div>
            </section>

            <section class="shell detail-grid" id="details">
                <article class="story">
                    <p class="kicker">The story</p>
                    <p>{label(movie.description)}</p>
                    <p class="kicker">Cast</p>
                    <p>{label(movie.cast)}</p>
                </article>
                <aside class="info-panel">
                    <p class="kicker">File information</p>
                    <dl>
                        <div><dt>Genre</dt><dd>{label(movie.genre)}</dd></div>
                        <div><dt>Language</dt><dd>{label(movie.languages)}</dd></div>
                        <div><dt>Duration</dt><dd>{label(movie.duration)}</dd></div>
                        <div><dt>Release year</dt><dd>{label(movie.releaseYear)}</dd></div>
                        <div><dt>Available size</dt><dd>{label(movie.sizes)}</dd></div>
                    </dl>
                </aside>
            </section>

            <section class="shell download-band">
                <div>
                    <p class="kicker">Ready when you are</p>
                    <h2>Download {movieTitle}</h2>
                    <p>High-quality {label(movie.languages)} version with subtitles.</p>
                </div>
                <a href={movie.downloadUrl || "#"}>Get download link</a>
            </section>

            {
                movie.screenshot ? (
                    <section class="shell screenshot-section">
                        <p class="kicker">Inside the experience</p>
                        <h2>Screenshot</h2>
                        <img
                            class="screenshot"
                            src={movie.screenshot}
                            alt={`${movie.title} screenshot`}
                            loading="lazy"
                        />
                    </section>
                ) : null
            }

            <section class="shell rail-section">
                <div class="rail-head">
                    <div>
                        <p class="kicker">Keep exploring</p>
                        <h2>Related <em>movies</em></h2>
                    </div>
                    <a href="/#latest">See all</a>
                </div>
                <div class="grid">
                    {
                        related.length ? (
                            related.slice(0, 10).map((item) => (
                                <a class="movie-card" href={`/movie/${item.slug}`}>
                                    <div class="thumb">
                                        {item.thumbnail ? (
                                            <img
                                                src={item.thumbnail}
                                                alt={item.title}
                                                loading="lazy"
                                            />
                                        ) : (
                                            <span>{siteConfig.branding.logoText}</span>
                                        )}
                                        <b class="year">{item.releaseYear || "-"}</b>
                                    </div>
                                    <div class="movie-info">
                                        <h3>{cleanTitle(item.title)}</h3>
                                        <p>{cleanGenre(item.genre || "Feature film")}</p>
                                    </div>
                                </a>
                            ))
                        ) : (
                            <p class="empty">No related movies found.</p>
                        )
                    }
                </div>
            </section>
        </main>

        <footer class="shell footer">
            <span>{siteConfig.branding.logoText} - made for movie people</span>
            <small>{copyrightText}</small>
            <nav class="footer-links">
                <a href="/about">About</a>
                <a href="/contact">Contact</a>
                <a href="/privacy-policy">Privacy</a>
                <a href="/dmca">DMCA</a>
                <a href="/movie-request">Request</a>
            </nav>
        </footer>

        <button class="floating-search" type="button" aria-label="Go to search">
            <svg viewBox="0 0 50 50" aria-hidden="true">
                <path d="M21 4C11.08 4 3 12.08 3 22s8.08 18 18 18c3.62 0 6.99-1.09 9.82-2.94l12.56 12.56 4.24-4.24-12.4-12.4A17.9 17.9 0 0 0 39 22C39 12.08 30.92 4 21 4Zm0 4c7.76 0 14 6.24 14 14s-6.24 14-14 14S7 29.76 7 22 13.24 8 21 8Z"></path>
            </svg>
        </button>

        <script>
            const searchInput = document.querySelector("#movie-search");
            document.querySelector(".floating-search")?.addEventListener("click", () => {
                searchInput?.scrollIntoView({ behavior: "smooth", block: "center" });
                setTimeout(() => searchInput?.focus({ preventScroll: true }), 400);
            });
        </script>
    </body>
</html>

<style>
    @import url("https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&display=swap");

    :global(*) {
        box-sizing: border-box;
    }

    :global(html) {
        scroll-behavior: smooth;
    }

    :global(body) {
        margin: 0;
        background: #e7ebef;
        color: #242832;
        font-family: Manrope, system-ui, sans-serif;
        overflow-x: hidden;
    }

    :global(a) {
        color: inherit;
        text-decoration: none;
    }

    .noise {
        position: fixed;
        inset: 0;
        opacity: 0.025;
        pointer-events: none;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.8' numOctaves='4'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.6'/%3E%3C/svg%3E");
    }

    .shell {
        width: min(1180px, calc(100% - 64px));
        margin: auto;
    }

    .nav {
        height: 105px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        position: relative;
        z-index: 2;
    }

    .brand {
        display: flex;
        align-items: center;
        gap: 12px;
        font-size: 13px;
        font-weight: 800;
        letter-spacing: 0.18em;
    }

    .mark {
        display: grid;
        place-items: center;
        width: 38px;
        height: 38px;
        border-radius: 12px;
        background: #252a33;
        color: #f2a17e;
        box-shadow: 7px 7px 14px #c5cbd1, -6px -6px 13px #fff;
        font-size: 18px;
    }

    .mark span {
        display: none;
    }

    nav {
        display: flex;
        gap: 28px;
        align-items: center;
        font-size: 12px;
        color: #6c7683;
    }

    nav a:hover {
        color: #242832;
    }

    .nav-pill,
    .primary {
        background: #252a33;
        color: #fff;
        border-radius: 100px;
        padding: 13px 18px;
        box-shadow: 7px 7px 14px #c5cbd1, -6px -6px 13px #fff;
    }

    .search-band {
        padding: 28px 0 18px;
    }

    .search {
        width: min(680px, 100%);
        margin: auto;
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 8px 8px 8px 19px;
        border-radius: 50px;
        box-shadow: inset 5px 5px 11px #cbd1d7, inset -5px -5px 11px #fff;
        color: #99a3ad;
    }

    .search span,
    .search span:before {
        display: block;
        width: 14px;
        height: 14px;
    }

    .search span {
        position: relative;
        flex: none;
        border: 2px solid #99a3ad;
        border-radius: 50%;
    }

    .search span:before {
        content: "";
        width: 7px;
        height: 2px;
        position: absolute;
        right: -6px;
        bottom: -3px;
        background: #99a3ad;
        transform: rotate(45deg);
        border-radius: 99px;
    }

    .search input {
        width: 100%;
        min-width: 0;
        border: 0;
        outline: 0;
        background: transparent;
        color: #252a33;
        font: 13px Manrope;
    }

    .search button {
        border: 0;
        border-radius: 50px;
        padding: 12px 18px;
        background: #ed8965;
        color: #fff;
        font: 700 12px Manrope;
        cursor: pointer;
    }

    .movie-hero {
        min-height: 600px;
        display: grid;
        grid-template-columns: 330px minmax(0, 1fr);
        align-items: center;
        gap: 72px;
        position: relative;
        padding: 52px 0 75px;
    }

    .back-link {
        position: absolute;
        top: 14px;
        left: 0;
        color: #7d8793;
        font: 500 11px DM Mono, monospace;
    }

    .poster-card {
        position: relative;
        overflow: hidden;
        border-radius: 18px;
        background: #ccd3da;
        box-shadow: 25px 29px 40px #bfc6cd, -15px -15px 35px #fff;
    }

    .poster-card img {
        display: block;
        width: 100%;
        aspect-ratio: 2/3;
        object-fit: cover;
    }

    .poster-card > span {
        display: grid;
        place-items: center;
        aspect-ratio: 2/3;
        color: #fff;
        background: linear-gradient(145deg, #242a35 15%, #f08d6c 115%);
        font-weight: 800;
    }

    .poster-card b,
    .year {
        position: absolute;
        top: 12px;
        right: 12px;
        padding: 6px 8px;
        border-radius: 8px;
        background: rgba(37, 42, 51, 0.75);
        color: #fff;
        font: 9px DM Mono, monospace;
    }

    .kicker {
        font: 500 10px/1 DM Mono, monospace;
        letter-spacing: 0.11em;
        text-transform: uppercase;
        color: #8a95a2;
        margin: 0;
    }

    .movie-copy h1 {
        max-width: 760px;
        margin: 22px 0 14px;
        color: #252a33;
        font-size: clamp(44px, 7vw, 88px);
        line-height: 0.95;
        letter-spacing: -0.06em;
    }

    .full-title {
        max-width: 620px;
        margin: 0;
        color: #7d8793;
        font-size: 15px;
        line-height: 1.75;
    }

    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin: 24px 0;
    }

    .tags span {
        border-radius: 50px;
        padding: 10px 14px;
        background: #e7ebef;
        color: #68778c;
        box-shadow: 5px 5px 10px #c9cfd5, -5px -5px 10px #fff;
        font: 11px Manrope;
    }

    .meta-line {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    .meta-line span {
        padding: 11px 14px;
        border-radius: 12px;
        background: #e7ebef;
        color: #68778c;
        box-shadow: inset 4px 4px 9px #cbd1d7, inset -4px -4px 9px #fff;
        font: 11px DM Mono, monospace;
    }

    .hero-actions {
        display: flex;
        align-items: center;
        gap: 20px;
        margin-top: 32px;
        font-size: 12px;
        font-weight: 700;
    }

    .primary {
        display: inline-flex;
        gap: 18px;
        align-items: center;
        background: #ed8965;
        padding: 16px 20px;
    }

    .quiet {
        color: #727d89;
    }

    .detail-grid {
        padding: 70px 0 0;
        border-top: 1px solid #d2d8de;
        display: grid;
        grid-template-columns: minmax(0, 1.35fr) minmax(280px, 0.65fr);
        gap: 70px;
    }

    .story p:not(.kicker) {
        color: #68778c;
        font-size: 15px;
        line-height: 1.85;
        margin: 18px 0 34px;
    }

    .info-panel,
    .download-band,
    .movie-card {
        background: #e7ebef;
        box-shadow: 7px 8px 16px #c8ced4, -7px -7px 16px #fff;
    }

    .info-panel {
        border-radius: 18px;
        padding: 24px;
        align-self: start;
    }

    dl {
        margin: 18px 0 0;
    }

    dl div {
        display: grid;
        grid-template-columns: 110px minmax(0, 1fr);
        gap: 16px;
        padding: 15px 0;
        border-bottom: 1px solid #d2d8de;
        font-size: 12px;
    }

    dl div:last-child {
        border-bottom: 0;
    }

    dt {
        color: #8a95a2;
    }

    dd {
        margin: 0;
        color: #242832;
        text-align: right;
        overflow-wrap: anywhere;
    }

    .download-band {
        margin-top: 72px;
        padding: 26px;
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
    }

    .download-band h2,
    .rail-head h2,
    .screenshot-section h2 {
        margin: 14px 0 0;
        color: #252a33;
        font-size: 39px;
        line-height: 1;
        letter-spacing: -0.06em;
    }

    .download-band p:not(.kicker) {
        color: #7d8793;
        margin: 10px 0 0;
    }

    .download-band a {
        display: inline-flex;
        justify-content: center;
        align-items: center;
        min-height: 48px;
        flex: none;
        border-radius: 100px;
        padding: 0 22px;
        background: #252a33;
        color: #fff;
        box-shadow: 7px 7px 14px #c5cbd1, -6px -6px 13px #fff;
        font-weight: 800;
        font-size: 12px;
    }

    .screenshot-section,
    .rail-section {
        padding: 80px 0 0;
    }

    .screenshot {
        display: block;
        width: 100%;
        margin-top: 24px;
        border-radius: 18px;
        box-shadow: 12px 12px 26px #c5cedb, -12px -12px 26px #ffffff;
    }

    .rail-head {
        display: flex;
        justify-content: space-between;
        align-items: end;
        margin-bottom: 27px;
    }

    .rail-head h2 em {
        color: #ef8965;
        font-style: normal;
    }

    .rail-head > a {
        color: #7d8793;
        font: 11px DM Mono, monospace;
    }

    .grid {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 16px;
    }

    .movie-card {
        min-width: 0;
        padding: 9px;
        border-radius: 14px;
        transition: transform 0.3s;
        cursor: pointer;
        overflow: hidden;
    }

    .movie-card:hover {
        transform: translateY(-8px);
    }

    .thumb {
        aspect-ratio: 2 / 3;
        border-radius: 10px;
        overflow: hidden;
        position: relative;
        background: #ccd3da;
        display: grid;
        place-items: center;
        color: #fff;
        font: 12px DM Mono, monospace;
    }

    .thumb img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .movie-info h3 {
        font-size: 12px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        margin: 13px 4px 5px;
    }

    .movie-info p {
        font: 9px DM Mono, monospace;
        color: #8a95a2;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        margin: 0 4px 4px;
    }

    .empty {
        color: #8a95a2;
        font-size: 13px;
    }

    .footer {
        border-top: 1px solid #d2d8de;
        margin-top: 100px;
        padding: 26px 0 36px;
        display: flex;
        align-items: center;
        gap: 18px;
        color: #8a95a2;
        font: 12px DM Mono, monospace;
    }

    .footer span {
        flex: 1;
    }

    .footer-links {
        display: flex;
        flex-wrap: wrap;
        gap: 12px 18px;
        font: 13px Manrope, system-ui, sans-serif;
    }

    .floating-search {
        display: none;
    }

    @media (max-width: 900px) {
        .shell {
            width: min(100% - 32px, 1180px);
        }

        nav a:not(.nav-pill) {
            display: none;
        }

        .movie-hero {
            min-height: auto;
            grid-template-columns: 1fr;
            gap: 34px;
            padding: 44px 0 58px;
        }

        .poster-card {
            width: min(280px, 82vw);
            margin: auto;
        }

        .movie-copy h1 {
            font-size: 44px;
            letter-spacing: -0.05em;
        }

        .detail-grid {
            grid-template-columns: 1fr;
            gap: 34px;
            padding-top: 52px;
        }

        .download-band {
            align-items: stretch;
            flex-direction: column;
        }

        .grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 14px;
        }

        .movie-card {
            padding: 7px;
            border-radius: 12px;
        }

        .movie-info h3 {
            font-size: 11px;
            margin: 10px 3px 4px;
        }

        .movie-info p {
            font-size: 8px;
            margin: 0 3px 4px;
        }

        .footer {
            align-items: flex-start;
            flex-direction: column;
            padding-bottom: 90px;
        }

        .floating-search {
            display: grid;
            place-items: center;
            position: fixed;
            z-index: 20;
            left: 50%;
            bottom: 18px;
            transform: translateX(-50%);
            width: 52px;
            height: 52px;
            padding: 0;
            border: 1px solid rgba(255, 255, 255, 0.7);
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.28);
            color: #252a33;
            box-shadow:
                8px 10px 22px rgba(139, 149, 160, 0.35),
                inset 1px 1px 4px rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            cursor: pointer;
        }

        .floating-search svg {
            width: 22px;
            height: 22px;
            fill: currentColor;
        }
    }

    @media (max-width: 390px) {
        .shell {
            width: calc(100% - 24px);
        }

        .movie-copy h1 {
            font-size: 38px;
        }

        .grid {
            gap: 10px;
        }

        .movie-card {
            padding: 6px;
        }

        .movie-info h3 {
            font-size: 10px;
        }

        .movie-info p {
            font-size: 7px;
        }

        .year {
            top: 6px;
            right: 6px;
            padding: 4px 5px;
            font-size: 8px;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        :global(*),
        :global(*::before),
        :global(*::after) {
            animation: none !important;
            transition: none !important;
            scroll-behavior: auto !important;
        }
    }
</style>
