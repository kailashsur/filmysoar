---
import {
    siteConfig,
    siteName,
    siteDescription,
    siteTitle,
    siteThemeColor,
    copyrightText,
} from "../../config/site";

export const prerender = false;

const apiBase = (
    import.meta.env.PUBLIC_API_BASE_URL || "http://127.0.0.1:3000"
).replace(/\/$/, "");
const emptyHome = {
    categories: [],
    pagination: { total: 0, totalPages: 0 },
    recentMovies: [],
    trendingMovies: [],
};
const currentPage = Math.max(
    2,
    Number(Astro.params.page || 2) || 2,
);
const getHome = async () => {
    try {
        const response = await fetch(
            `${apiBase}/api/home?page=${currentPage}`,
            { method: "GET", signal: AbortSignal.timeout(3000) },
        );
        if (!response.ok) throw new Error("home api");
        const result = await response.json();
        return result.data ?? emptyHome;
    } catch {
        return emptyHome;
    }
};
const home = await getHome();
const movies = home.recentMovies ?? [];
const trending = home.trendingMovies ?? [];
const categories = home.categories ?? [];
const name = (s = "") =>
    s
        .replace(/\s*\([^)]*\)/g, "")
        .replace(
            /\s+(Dual Audio|Hindi|English|Movie|Web Series|HD|ESub|BluRay|HDRip).*$/i,
            "",
        )
        .trim();
const genre = (s = "") =>
    s
        .replace(/\s*\[.*?\]/g, "")
        .replace(/ Movies?$/i, "")
        .trim();
const link = (m) => `/movie/${m.slug}`;
const total = home.pagination?.total?.toLocaleString() ?? "0";
const totalPages = Math.max(1, Number(home.pagination?.totalPages || 1));
const pageHref = (pageNumber) => pageNumber === 1 ? "/#latest" : `/page/${pageNumber}#latest`;
const pages = Array.from(
    new Set(
        [
            1,
            currentPage - 1,
            currentPage,
            currentPage + 1,
            totalPages,
        ].filter((pageNumber) => pageNumber >= 1 && pageNumber <= totalPages),
    ),
).sort((a, b) => a - b);
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport"  content="width=device-width,initial-scale=1,viewport-fit=cover" />
        <meta
            name="description"
            content="FilmyFly — a living archive for curious movie people."
        />
     
        <meta name="description" content={siteDescription} />
        <meta name="theme-color" content={siteThemeColor} />

        <title>
            {siteTitle || `${siteName} - Discover your next movie`}
        </title>
    </head>
    <body>
        <div class="noise"></div>
        <header class="shell nav">
            <a class="brand" href="/"
                ><span class="mark">{siteConfig.branding.logoMark}<span>↗</span></span><span>{siteConfig.branding.logoText}</span
                ></a
            >
            <nav>
                <a href="#discover">Discover</a><a href="#trending">Trending</a
                ><a class="nav-pill" href="#latest">Explore archive <b>↗</b></a>
            </nav>
        </header>

        <main>
            <section class="shell hero">
                <form class="search hero-search" id="movie-search-form"><span>?</span><input id="search" name="q" type="search" placeholder="Search a title, genre, feeling..." /><button type="submit">Search</button></form>
                <div class="hero-copy">
                    <p class="kicker"><i></i> The cinema is open</p>
                    <h1>Stories that<br /><em>move</em> you.</h1>
                    <p class="lede">
                        A considered collection of films and series for the
                        relentlessly curious. Find the one that stays with you.
                    </p>
                    <div class="hero-actions">
                        <a class="primary" href="#latest"
                            >Start exploring <span>↓</span></a
                        ><a class="quiet" href="#discover"
                            >Browse by mood <span>↗</span></a>
                    </div>
                    <div class="proof">
                        <div class="avatars">
                            <span>✦</span><span>◒</span><span>✺</span>
                        </div><p>
                            <strong id="hero-count">2,458</strong> stories<br
                            /><small>and counting</small>
                        </p>
                    </div>
                </div>
                <div class="hero-stage" aria-hidden="true">
                    <div class="halo halo-a"></div><div class="halo halo-b">
                    </div><div class="poster-hero">
                        <div class="poster-glow"></div><span
                            class="poster-label">FILMY<br />FLY</span
                        ><small>EST. 2025</small>
                    </div>
                    <div class="orbit-card card-top">
                        <span>01</span><strong
                            >Tonight's<br />perfect watch</strong
                        ><b>↗</b>
                    </div>
                    <div class="orbit-card card-bottom">
                        <span class="live-dot"></span> Curated daily <b>✦</b>
                    </div>
                </div>
            </section>

            <section id="discover" class="shell discover">
                <div class="section-intro">
                    <p class="kicker">01 / Explore the archive</p><h2>
                        Where do you want<br /><em>to go?</em>
                    </h2>
                </div>
                <label class="search"
                    ><span>⌕</span><input
                        id="category-search"
                        type="search"
                        placeholder="Search a title, genre, feeling..."
                    /></label
                >
                <div id="chips" class="chips">
                    {categories.length ? categories.map((category) => (
                        <a class="chip" href={`/categories/${category.slug}`}>
                            <span class="chip-dot"></span>
                            {genre(category.name)}
                            {category._count?.movies ? <small>{category._count.movies}</small> : null}
                        </a>
                    )) : <p class="empty">No categories available.</p>}
                </div>
            </section>

            <section id="trending" class="shell rail-section">
                <div class="rail-head">
                    <div>
                        <p class="kicker">02 / Right now</p><h2>
                            Trending <em>now</em>
                        </h2>
                    </div><p class="rail-note">
                        The stories everyone's<br />talking about <span>→</span>
                    </p>
                </div><div id="trending-grid" class="grid">
                    {trending.length ? trending.slice(0, 10).map((m) => (
                        <a class="movie-card" href={link(m)}>
                            <div class="thumb">
                                {m.thumbnail ? <img src={m.thumbnail} alt={m.title} loading="lazy" /> : <span>{siteConfig.branding.logoText}</span>}
                                <b class="year">{m.releaseYear || "-"}</b>
                            </div>
                            <div class="movie-info"><h3>{name(m.title)}</h3><p>{genre(m.genre || "Feature film")} <span>·</span> {m.duration || "-"}</p></div>
                        </a>
                    )) : <p class="empty">No trending movies found.</p>}
                </div>
            </section>
            <section id="latest" class="shell rail-section latest">
                <div class="rail-head">
                    <div>
                        <p class="kicker">03 / Fresh arrivals</p><h2>
                            Latest <em>releases</em>
                        </h2>
                    </div><p class="archive-count">
                        <strong id="total-count">2,458</strong><br />titles in
                        the archive
                    </p>
                </div><div id="latest-grid" class="grid">
                    {movies.length ? movies.map((m, i) => (
                        <a class="movie-card" href={link(m)}>
                            <div class="thumb">
                                {m.thumbnail ? <img src={m.thumbnail} alt={m.title} loading={i < 5 ? "eager" : "lazy"} /> : <span>{siteConfig.branding.logoText}</span>}
                                <b class="year">{m.releaseYear || "-"}</b>
                            </div>
                            <div class="movie-info"><h3>{name(m.title)}</h3><p>{genre(m.genre || "Feature film")} <span>·</span> {m.duration || "-"}</p></div>
                        </a>
                    )) : <p class="empty">No latest movies found.</p>}
                </div>
                {totalPages > 1 && (
                    <nav class="pagination" aria-label="Latest releases pagination">
                        {currentPage > 1 ? (
                            <a class="page-control" href={pageHref(currentPage - 1)}>Previous</a>
                        ) : (
                            <span class="page-control is-disabled">Previous</span>
                        )}
                        <div class="page-numbers">
                            {pages.map((pageNumber, index) => (
                                <>
                                    {index > 0 && pageNumber - pages[index - 1] > 1 ? (
                                        <span class="dots">...</span>
                                    ) : null}
                                    <a
                                        class={pageNumber === currentPage ? "active" : ""}
                                        href={pageHref(pageNumber)}
                                        aria-current={pageNumber === currentPage ? "page" : undefined}
                                    >
                                        {pageNumber}
                                    </a>
                                </>
                            ))}
                        </div>
                        {currentPage < totalPages ? (
                            <a class="page-control" href={pageHref(currentPage + 1)}>Next</a>
                        ) : (
                            <span class="page-control is-disabled">Next</span>
                        )}
                    </nav>
                )}
            </section>
        </main>
        <footer class="shell footer">
            <span>{siteConfig.branding.logoText} <i>·</i> made for movie people</span>
            
        </footer>
        <button class="floating-search" type="button" aria-label="Go to search">
<svg xmlns="http://www.w3.org/2000/svg" x="0px" y="0px" width="100" height="100" viewBox="0 0 50 50">
<path d="M 21 4 C 11.082241 4 3 12.082241 3 22 C 3 31.917759 11.082241 40 21 40 C 24.62177 40 27.99231 38.91393 30.820312 37.0625 L 43.378906 49.621094 L 47.621094 45.378906 L 35.224609 32.982422 C 37.581469 29.938384 39 26.13473 39 22 C 39 12.082241 30.917759 4 21 4 z M 21 8 C 28.756241 8 35 14.243759 35 22 C 35 29.756241 28.756241 36 21 36 C 13.243759 36 7 29.756241 7 22 C 7 14.243759 13.243759 8 21 8 z"></path>
</svg>
        </button>

        <script define:vars={{ movieData: movies }}>
            const gsap = window.gsap;
            const clean = (v = "") => v.replace(/\s+/g, " ").trim();
            let movies = movieData;
            const card = (m) =>
                `<article class="movie-card"><div class="thumb">${m.thumbnail ? `<img src="${m.thumbnail}" alt="${clean(m.title)} poster" loading="lazy">` : `<span>${siteConfig.branding.logoText}</span>`}<b class="year">${m.releaseYear || "—"}</b></div><div class="movie-info"><h3>${clean(m.title)}</h3><p>${clean(m.genre || "Feature film")} <span>·</span> ${m.duration || "—"}</p></div></article>`;
            const render = (id, list) => {
                const el = document.querySelector(id);
                el.classList.remove("loading");
                el.innerHTML = list.length
                    ? list.slice(0, 10).map(card).join("")
                    : '<p class="empty">No stories found.</p>';
                if (gsap) gsap.from(`${id} .movie-card`, {
                    y: 30, opacity: 0, stagger: 0.07, duration: 0.7, ease: "power3.out",
                });
            };
            document.querySelector("#movie-search-form")?.addEventListener("submit", (event) => {
                event.preventDefault();
                const query = document.querySelector("#search")?.value.trim();
                if (query) window.location.href = `/search?q=${encodeURIComponent(query)}`;
            });
            document.querySelector(".floating-search")?.addEventListener("click", () => {
                document.querySelector("#search")?.scrollIntoView({ behavior: "smooth", block: "center" });
                setTimeout(() => document.querySelector("#search")?.focus({ preventScroll: true }), 400);
            });
            if (gsap) {
                const intro = gsap.timeline({ defaults: { ease: "power3.out" } });
            intro
                .from(".nav", { y: -20, opacity: 0, duration: 0.8 })
                .from(
                    ".hero-copy > *",
                    { y: 26, opacity: 0, stagger: 0.1, duration: 0.8 },
                    "-=.45",
                )
                .from(
                    ".hero-stage",
                    { scale: 0.9, opacity: 0, duration: 1 },
                    "-=.8",
                );
            gsap.to(".poster-hero", {
                y: -13,
                rotation: 3,
                duration: 3.5,
                repeat: -1,
                yoyo: true,
                ease: "sine.inOut",
            });
            gsap.to(".halo-a", {
                rotation: 360,
                duration: 24,
                repeat: -1,
                ease: "none",
            });
            gsap.to(".halo-b", {
                rotation: -360,
                duration: 30,
                repeat: -1,
                ease: "none",
            });
            }
        </script>
    </body>
</html>
<style>
