px DM Mono}.thumb img{width:100%;height:100%;object-fit:cover;display:block}.year{position:absolute;top:9px;right:9px;padding:5px 7px;border-radius:7px;background:rgba(37,42,51,.75);color:#fff;font:9px DM Mono}.movie-info h3{font-size:12px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin:13px 4px 5px}.movie-info p{font:9px DM Mono;color:#8a95a2;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin:0 4px 4px}.movie-info p span{color:#ed8965}.latest{padding-bottom:100px}.footer{border-top:1px solid #d2d8de;padding:26px 0 36px;display:flex;justify-content:space-between;color:#8a95a2;font:10px DM Mono}.footer i{color:#ed8965;font-style:normal}.footer b{color:#ed8965;margin-left:8px}.empty{color:#8a95a2;font-size:13px}.loading{min-height:120px;color:#8a95a2;font:11px DM Mono}
  @media(max-width:800px){.shell{width:min(100% - 32px,1180px)}nav a:not(.nav-pill){display:none}.hero{grid-template-columns:1fr;min-height:auto;padding:70px 0 100px}.hero-stage{height:440px;order:-1}.poster-hero{width:190px;height:270px}.halo-a{width:370px}.halo-b{height:380px}.card-top{right:0;top:65px}.card-bottom{left:0;bottom:40px}.discover{display:block}.search{margin-top:32px}.chips{margin-top:22px}.grid{grid-template-columns:repeat(2,1fr)}.thumb{height:245px}.rail-head{align-items:start}.rail-note{display:none}.section-intro h2{font-size:40px}}
  .grid{grid-template-columns:repeat(5,minmax(0,1fr));align-items:start}.movie-card{min-width:0;width:100%;overflow:hidden}.thumb{height:auto;aspect-ratio:2/3}.movie-info{min-width:0}.movie-info h3,.movie-info p{max-width:100%}
  @media(max-width:800px){.shell{width:min(100% - 28px,1180px)}.grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.movie-card{padding:7px;border-radius:12px}.movie-info h3{font-size:11px;margin:10px 3px 4px}.movie-info p{font-size:8px;margin:0 3px 4px}.thumb{aspect-ratio:2/3}.rail-section{padding-top:58px}.rail-head{gap:12px}.rail-head>div{min-width:0}}
  @media(max-width:390px){.shell{width:calc(100% - 24px)}.grid{gap:10px}.movie-card{padding:6px}.movie-info h3{font-size:10px}.movie-info p{font-size:7px}.year{top:6px;right:6px;padding:4px 5px;font-size:8px}}
  .hero{grid-template-columns:1fr;display:block;min-height:0;padding:48px 0 42px}.hero-copy,.hero-stage{display:none}.hero-search{width:min(680px,100%);margin:0 auto 28px;border:0;overflow:hidden;background:#e7ebef;border-radius:50px;box-shadow:inset 5px 5px 11px #cbd1d7,inset -5px -5px 11px #fff}.hero-search button{border:0;border-radius:50px;padding:11px 15px;background:#252a33;color:#fff;font:600 11px Manrope;cursor:pointer}.hero-trending{max-width:100%;margin:0 auto}.hero-trending-list{display:flex;gap:16px;margin-top:16px;overflow:hidden;padding:8px 6px 18px}.hero-trending-list:hover{animation-play-state:paused}.hero-trending-card{display:grid;grid-template-columns:28px 72px 155px;align-items:center;gap:10px;flex:0 0 285px;padding:10px;border-radius:14px;background:#e7ebef;box-shadow:7px 8px 16px #c8ced4,-7px -7px 16px #fff;min-width:0}.hero-trending-card>span{font:10px DM Mono;color:#ed8965}.hero-trending-card img{width:72px;height:92px;object-fit:cover;border-radius:9px}.hero-trending-card strong{font-size:12px;line-height:1.35;overflow:hidden;text-overflow:ellipsis}.discover>.search{display:none}
