---
import { siteConfig, siteName, siteDescription, siteThemeColor, copyrightText } from "../config/site";

const apiBase = (
    import.meta.env.PUBLIC_API_BASE_URL || "http://127.0.0.1:3000"
).replace(/\/$/, "");

const getCategories = async () => {
    try {
        const response = await fetch(`${apiBase}/api/categories`, {
            method: "GET",
            signal: AbortSignal.timeout(3000),
        });
        if (!response.ok) throw new Error("Categories API error");
        const result = await response.json();
        return Array.isArray(result.data) ? result.data : [];
    } catch {
        return [];
    }
};

const categories = await getCategories();
const label = (value = "") => value.replace(/\s*\[.*?\]/g, "").trim();
const total = categories.reduce(
    (sum, category) => sum + (category._count?.movies || 0),
    0,
);
---

<!doctype html>
<html lang={siteConfig.site.language}>
    <head>
        <meta charset="UTF-8" />
        <meta
            name="viewport"
            content="width=device-width,initial-scale=1,viewport-fit=cover"
        />
        <meta
            name="description"
            content={`Browse all ${siteName} movie categories with current movie counts.`}
        />
        <meta name="theme-color" content={siteThemeColor} />
        <title>Browse Categories - {siteName}</title>
    </head>
    <body>
        <div class="noise"></div>
        <header class="shell nav">
            <a class="brand" href="/" aria-label={`${siteName} home`}>
                <span class="mark">{siteConfig.branding.logoMark}</span>
                <span>{siteConfig.branding.logoText}</span>
            </a>
            <nav>
                <a href="/#discover">Discover</a>
                <a href="/#trending">Trending</a>
                <a class="nav-pill" href="/categories">Genres</a>
            </nav>
        </header>

        <main>
            <section class="shell intro">
                <p class="kicker">The {siteConfig.branding.logoText} library</p>
                <h1>Choose your <em>next mood.</em></h1>
                <p>{siteDescription}</p>
                <label class="search">
                    <span></span>
                    <input
                        id="category-search"
                        aria-label="Filter categories"
                        placeholder="Filter categories"
                        autocomplete="off"
                    />
                </label>
            </section>

            <section class="shell category-section" aria-live="polite">
                <div class="rail-head">
                    <div>
                        <p class="kicker">All categories</p>
                        <h2>{categories.length} ways to <em>watch</em></h2>
                    </div>
                    <p class="rail-note">{total.toLocaleString()} counted titles</p>
                </div>
                <div class="category-grid">
                    {
                        categories.map((category, index) => (
                            <a
                                class="category-card"
                                href={`/categories/${category.slug}`}
                                data-category={label(category.name).toLowerCase()}
                            >
                                <span class="number">
                                    {String(index + 1).padStart(2, "0")}
                                </span>
                                <span class="dot"></span>
                                <div>
                                    <h3>{label(category.name)}</h3>
                                    <p>
                                        {category._count?.movies || 0}{" "}
                                        {category._count?.movies === 1
                                            ? "movie"
                                            : "movies"}{" "}
                                        available
                                    </p>
                                </div>
                                <b>View</b>
                            </a>
                        ))
                    }
                </div>
                <div class="empty" hidden>No categories match that search.</div>
            </section>
        </main>

        <footer class="shell footer">
            <span>{siteConfig.branding.logoText} - made for movie people</span>
            <small>{copyrightText}</small>
            <nav class="footer-links">
                <a href="/about">About</a>
                <a href="/contact">Contact</a>
                <a href="/privacy-policy">Privacy</a>
                <a href="/dmca">DMCA</a>
                <a href="/movie-request">Request</a>
            </nav>
        </footer>

        <script>
            const input = document.querySelector("#category-search");
            const cards = [...document.querySelectorAll("[data-category]")];
            const empty = document.querySelector(".empty");
            input?.addEventListener("input", (event) => {
                const query = event.target.value.trim().toLowerCase();
                let visible = 0;
                cards.forEach((card) => {
                    const match = !query || card.dataset.category.includes(query);
                    card.hidden = !match;
                    if (match) visible++;
                });
                if (empty) empty.hidden = visible !== 0;
            });
        </script>
    </body>
</html>

<style>
    @import url("https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&display=swap");
    :global(*){box-sizing:border-box}:global(body){margin:0;background:#e7ebef;color:#242832;font-family:Manrope,system-ui,sans-serif;overflow-x:hidden}:global(a){color:inherit;text-decoration:none}.noise{position:fixed;inset:0;opacity:.025;pointer-events:none;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.8' numOctaves='4'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.6'/%3E%3C/svg%3E")}.shell{width:min(1180px,calc(100% - 64px));margin:auto}.nav{height:105px;display:flex;align-items:center;justify-content:space-between}.brand{display:flex;align-items:center;gap:12px;font-size:13px;font-weight:800;letter-spacing:.18em}.mark{display:grid;place-items:center;width:38px;height:38px;border-radius:12px;background:#252a33;color:#f2a17e;box-shadow:7px 7px 14px #c5cbd1,-6px -6px 13px #fff;font-size:18px}nav{display:flex;gap:28px;align-items:center;font-size:12px;color:#6c7683}.nav-pill{background:#252a33;color:#fff;border-radius:100px;padding:13px 18px;box-shadow:7px 7px 14px #c5cbd1,-6px -6px 13px #fff}.intro{padding:78px 0 70px;border-bottom:1px solid #d2d8de}.kicker{margin:0;color:#8a95a2;font:500 10px/1 DM Mono,monospace;letter-spacing:.11em;text-transform:uppercase}.intro h1,.rail-head h2{margin:22px 0 18px;color:#252a33;font-size:clamp(48px,7vw,82px);line-height:.95;letter-spacing:-.06em}.intro h1 em,.rail-head h2 em{color:#ef8965;font-style:normal}.intro p:not(.kicker){max-width:620px;margin:0 0 30px;color:#7d8793;font-size:15px;line-height:1.75}.search{width:min(620px,100%);display:flex;align-items:center;gap:12px;padding:14px 18px;border-radius:50px;box-shadow:inset 5px 5px 11px #cbd1d7,inset -5px -5px 11px #fff;color:#99a3ad}.search span{position:relative;flex:none;width:14px;height:14px;border:2px solid #99a3ad;border-radius:50%}.search span:before{content:"";position:absolute;right:-6px;bottom:-3px;width:7px;height:2px;background:#99a3ad;transform:rotate(45deg);border-radius:99px}.search input{width:100%;border:0;outline:0;background:transparent;color:#252a33;font:13px Manrope}.category-section{padding:80px 0 90px}.rail-head{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:27px}.rail-head h2{font-size:39px;margin-top:14px}.rail-note{color:#8a95a2;font:10px DM Mono,monospace;text-align:right}.category-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.category-card{display:flex;align-items:center;gap:13px;min-width:0;padding:16px;border-radius:16px;background:#e7ebef;box-shadow:7px 8px 16px #c8ced4,-7px -7px 16px #fff;transition:transform .25s}.category-card:hover{transform:translateY(-4px)}.number{width:28px;color:#8a95a2;font:700 11px DM Mono,monospace}.dot{width:9px;height:9px;flex:none;border-radius:50%;background:#ed8965;box-shadow:0 0 0 5px rgba(237,137,101,.12)}.category-card div{min-width:0;flex:1}.category-card h3{margin:0 0 4px;font-size:14px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.category-card p{margin:0;color:#8a95a2;font:10px DM Mono,monospace}.category-card b{color:#252a33;font-size:12px}.empty{padding:34px;margin-top:18px;border-radius:18px;background:#e7ebef;box-shadow:7px 8px 16px #c8ced4,-7px -7px 16px #fff;color:#8a95a2;text-align:center}.footer{border-top:1px solid #d2d8de;padding:26px 0 36px;display:flex;align-items:center;gap:18px;color:#8a95a2;font:12px DM Mono,monospace}.footer span{flex:1}.footer-links{display:flex;flex-wrap:wrap;gap:12px 18px;font:13px Manrope,system-ui,sans-serif}@media(max-width:800px){.shell{width:min(100% - 28px,1180px)}.nav{height:86px}nav a:not(.nav-pill){display:none}.intro{padding:46px 0 58px}.intro h1{font-size:44px;letter-spacing:-.05em}.rail-head{align-items:start}.rail-note{display:none}.category-grid{grid-template-columns:1fr}.footer{align-items:flex-start;flex-direction:column}}@media(prefers-reduced-motion:reduce){*{transition:none!important}}
</style>
